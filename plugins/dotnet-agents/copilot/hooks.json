{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook pre-tool-use",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook pre-tool-use",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook post-tool-use",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook post-tool-use",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook subagent-start",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook subagent-start",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook subagent-stop",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook subagent-stop",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook stop",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook stop",
        "timeoutSec": 10
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook session-start",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook session-start",
        "timeoutSec": 10
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook pre-compact",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook pre-compact",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook api-error",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook api-error",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "dotnet \"${PLUGIN_ROOT:-$COPILOT_PLUGIN_ROOT}/engine/agents.dll\" hook session-end",
        "powershell": "dotnet \"$(if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { $env:COPILOT_PLUGIN_ROOT })/engine/agents.dll\" hook session-end",
        "timeoutSec": 10
      }
    ]
  }
}
